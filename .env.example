# ---------------------------------------------------------------------------
# Enterprise AI Employee - environment variable template
#
# Copy to .env and fill in real values. NEVER commit .env.
# Config files in config/*.yaml reference these variables; secrets live here
# only. See docs/ARCHITECTURE.md (Infrastructure Layer).
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=local
APP_LOG_LEVEL=INFO

# --- LLM (Qwen, accessed only through src/core/llm_client.py) --------------
# The concrete Qwen endpoint / SDK adapter is decided in Phase 1 (see ADR.md).
LLM_PROVIDER=qwen
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Embedding / Reranker (local models by default) ------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
HF_HOME=

# --- Milvus (vector retrieval only) ---------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION=enterprise_knowledge
MILVUS_METRIC_TYPE=IP
MILVUS_INDEX_TYPE=HNSW

# --- Neo4j (knowledge graph / relation queries only) ----------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- DuckDB (read-only business database) ---------------------------------
DUCKDB_PATH=data/duckdb/enterprise.duckdb
DUCKDB_READ_ONLY=true
SQL_MAX_ROWS=1000
SQL_TIMEOUT_SECONDS=30

# --- Evaluation ------------------------------------------------------------
EVAL_DATASET_PATH=data/eval_dataset.jsonl
EVAL_OUTPUT_DIR=outputs/eval
